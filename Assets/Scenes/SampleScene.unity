  m_Script: {fileID: 11500000, guid: e5d24ce8bc3c08b4b8787bbb1edd8128, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Monte Luvili
  descricao: "O Monte Luvili \xE9 uma forma\xE7\xE3o rochosa do Planalto Central
    de Angola, vis\xEDvel da estrada principal entre Luanda e o Huambo. Pela forma
    pontiaguda, \xE9 muitas vezes comparado a um dente de tubar\xE3o. \xC9 o que
    resta de uma antiga intrus\xE3o vulc\xE2nica, que a eros\xE3o foi deixando a
    descoberto ao longo de milh\xF5es de anos, e \xE9 considerado um dos maiores
    mon\xF3litos do mundo. Pela sua imagem inconfund\xEDvel, aparece tamb\xE9m numa
    nota de 1000 kwanzas."
  data: "Forma\xE7\xE3o vulc\xE2nica antiga"
  localizacao: Planalto Central, Angola
  modeloPrefab: {fileID: 8771091787928289351, guid: f676e97e8d7704c4db86689bb1357ba8, type: 3}
  rotacaoInicial: {x: 0, y: 0, z: 0}
  narracao: {fileID: 8300000, guid: 46bc1392eed33034ba2f1c07c634ca9b, type: 3}
  musicaFundo: {fileID: 0}
