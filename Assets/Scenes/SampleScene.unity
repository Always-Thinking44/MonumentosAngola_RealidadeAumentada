  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Mbanza Kongo
  descricao: "Mbanza Kongo, na prov\xEDncia do Zaire, foi a capital pol\xEDtica e
    espiritual do Reino do Kongo, um dos maiores Estados da \xC1frica Austral, activo
    entre os s\xE9culos XIV e XIX. A cidade fica num planalto a 570 metros de altitude.
    \xC9 o lugar da \xC1frica Subsaariana que melhor mostra as profundas mudan\xE7as
    trazidas pela chegada dos portugueses e do cristianismo \xE0 \xC1frica Central.
    Os vest\xEDgios da antiga capital foram inscritos pela UNESCO na lista do Patrim\xF3nio
    Mundial da Humanidade em 2017."
  data: "Patrim\xF3nio Mundial desde 2017"
  localizacao: Mbanza Kongo, Zaire
  modeloPrefab: {fileID: 8771091787928289351, guid: 92f4098ac5884bd4cb124ee06afdf615, type: 3}
