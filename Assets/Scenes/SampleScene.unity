  m_Script: {fileID: 11500000, guid: e5d24ce8bc3c08b4b8787bbb1edd8128, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Mwana Pwo
  descricao: "A Mwana Pwo, que significa \xABjovem mulher\xBB na l\xEDngua Tchokwe,
    \xE9 uma m\xE1scara que representa a mulher ideal e honra as antepassadas fundadoras
    da linhagem. Apesar de representar uma mulher, \xE9 dan\xE7ada e usada exclusivamente
    por homens durante o Mukanda, o rito de inicia\xE7\xE3o dos rapazes. Os seus
    passos lentos e graciosos servem para entreter e homenagear as m\xE3es dos iniciados.
    As cicatrizes tribais no rosto, os olhos em fenda e o penteado de fibra fazem
    parte do seu desenho. A tradi\xE7\xE3o \xE9 muito antiga, mas a sua idade exacta
    n\xE3o est\xE1 documentada."
  data: "S\xE9c. XIX ou antes"
  localizacao: Lundas e Moxico
  modeloPrefab: {fileID: 4814140183114437194, guid: 90276512aa0d7c141a9c1b966efd8398, type: 3}
  rotacaoInicial: {x: 0, y: 0, z: 0}
  narracao: {fileID: 8300000, guid: ce36e20a78631114583c99bc2d99f6ec, type: 3}
  musicaFundo: {fileID: 8300000, guid: b748dced898a59b4eaf7678601b4d3b3, type: 3}
