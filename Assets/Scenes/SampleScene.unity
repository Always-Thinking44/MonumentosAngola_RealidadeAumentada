  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Soldado Desconhecido
  descricao: "Monumento ao Soldado Desconhecido, em Luanda, presta homenagem aos
    soldados tombados pela p\xE1tria. Fica na Marginal de Luanda, entre os Correios
    de Angola e o Comando da Marinha de Guerra, e foi inaugurado em Setembro de 2017.
    Tem 23 metros de altura e uma rampa com 50 metros de comprimento. No topo, uma
    chama sobe atrav\xE9s de uma estrela dourada, que simboliza a mais alta condecora\xE7\xE3o
    concedida aos soldados tombados."
  data: Inaugurado em Set. 2017
  localizacao: Marginal de Luanda
  modeloPrefab: {fileID: 8771091787928289351, guid: 97d56f169bd40264e8b96ad019d9dc15, type: 3}
  rotacaoInicial: {x: 0, y: 0, z: 0}
