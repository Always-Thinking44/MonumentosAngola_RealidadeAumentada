  m_Script: {fileID: 11500000, guid: e5d24ce8bc3c08b4b8787bbb1edd8128, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Marimba
  descricao: "A marimba \xE9 um instrumento tradicional de Angola, muito ligado ao
    povo Ambundo, na prov\xEDncia de Malanje. \xC9 feita de teclas de madeira dispostas
    sobre caba\xE7as que amplificam o som. O seu nome vem de \xABmadimba\xBB, em
    Kimbundu, e de \xABndjimba\xBB, em Tchokwe. \xC9 ancestral do xilofone e j\xE1
    aparece em ilustra\xE7\xF5es angolanas do s\xE9culo XVII. Tal como um piano,
    tem de ser afinada, e continua a ser um patrim\xF3nio musical que importa preservar."
  data: "Documentada no s\xE9c. XVII"
  localizacao: Malanje
  modeloPrefab: {fileID: -6689036041284674117, guid: d01caaa8ae9596144b2cd0272cf47e24, type: 3}
  rotacaoInicial: {x: 0, y: 0, z: 0}
  narracao: {fileID: 8300000, guid: ebffb3800f1df974a8f32433e26bc325, type: 3}
  musicaFundo: {fileID: 8300000, guid: 13a8a589dd1bb7849b613e0dcf6cd9cc, type: 3}
