  m_Script: {fileID: 11500000, guid: e5d24ce8bc3c08b4b8787bbb1edd8128, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonumentTarget
  nome: Palanca Negra Gigante
  descricao: "A Palanca Negra Gigante \xE9 um ant\xEDlope que s\xF3 existe em Angola,
    entre os rios Cuango e Luando, e \xE9 um dos maiores s\xEDmbolos do pa\xEDs.
    Foi descrita pela ci\xEAncia em 1916. Depois da guerra civil chegou a ser dada
    como extinta, at\xE9 ser filmada em 2004 no Parque Nacional da Cangandala. Hoje
    est\xE1 criticamente amea\xE7ada: contam-se cerca de 430 animais recenseados,
    entre a Cangandala e a Reserva do Luando. A ca\xE7a furtiva e a perda de habitat
    continuam a ser os seus maiores riscos."
  data: Descrita em 1916
  localizacao: Malanje (Cangandala e Luando)
  modeloPrefab: {fileID: -6689036041284674117, guid: f8ce6b3af4b5bd0428f9caace47f6d4f, type: 3}
  rotacaoInicial: {x: -90, y: 0, z: 0}
  narracao: {fileID: 8300000, guid: 8faf30ec2b6edac4eb06f6d7353b5cb5, type: 3}
  musicaFundo: {fileID: 8300000, guid: 13a8a589dd1bb7849b613e0dcf6cd9cc, type: 3}
