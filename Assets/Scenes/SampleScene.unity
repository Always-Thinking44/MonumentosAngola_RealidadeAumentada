  m_Script: {fileID: 11500000, guid: 7da19681b7b36274c8e69472c58e9854, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AngolaTarget
  titulo: Angola
  descricao: "Angola situa-se na costa ocidental da \xC1frica Austral e \xE9 um pa\xEDs
    de grande diversidade natural e cultural. O territ\xF3rio \xE9 marcado por planaltos,
    rios e uma extensa costa atl\xE2ntica, reunindo paisagens muito diferentes entre
    o litoral, o interior e o nordeste. A sua hist\xF3ria cruza os povos bantu, o
    antigo Reino do Kongo e a heran\xE7a portuguesa, vis\xEDvel na l\xEDngua, na
    m\xFAsica e nas tradi\xE7\xF5es. Percorra o mapa e descubra os monumentos e manifesta\xE7\xF5es
    culturais de cada prov\xEDncia."
  modeloPrefab: {fileID: 8771091787928289351, guid: 249ed33123ce4154d83fa21500ac181c, type: 3}
  rotacaoInicial: {x: 90, y: 180, z: 0}
  tamanhoAlvo: 3.2
  velocidadeGiro: 20
  narracao: {fileID: 8300000, guid: f1656962eeb59a44c8f6ae94770cf8e7, type: 3}
  musicaFundo: {fileID: 8300000, guid: 8e5f591340dc80e4f81d5102cf65e675, type: 3}
  esconderAoPerderTarget: 1
